# PostgreSQL connection string used only by the backend.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Generate a long, random value for production. Never expose this to the frontend.
JWT_SECRET="replace-with-a-long-random-secret"

# 32-byte encryption key encoded as 64 hexadecimal characters.
ENCRYPTION_KEY="replace-with-64-hexadecimal-characters"

# Public frontend origin allowed by CORS. Do not include a trailing slash.
FRONTEND_URL="http://localhost:3000"

PORT=5000
